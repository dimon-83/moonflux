{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {
    "name": "sdf-update-state-merge-service"
  },
  "spec": {
    "source": {
      "type": "topic",
      "name": "temperature-partial-stream",
      "from": "beginning"
    },
    "topic": {
      "name": "temperature-partial-stream"
    },
    "state": {
      "topic": "temperature-merge"
    },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-keyfield/operator-keyfield.wasm",
        "config": {
          "field": "id"
        }
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-loadtable/operator-loadtable.wasm",
        "config": {
          "key_field": "id",
          "value_fields": [
            "sensor",
            "temperature"
          ],
          "merge": true
        }
      }
    ],
    "sink": {
      "type": "stdout"
    }
  }
}
