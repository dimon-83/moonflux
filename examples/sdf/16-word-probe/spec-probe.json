{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {
    "name": "sdf-word-probe-probe"
  },
  "spec": {
    "source": {
      "type": "topic",
      "name": "word-stream",
      "from": "beginning"
    },
    "topic": {
      "name": "word-stream"
    },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-wordkeys/operator-wordkeys.wasm",
        "config": {}
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-probe/operator-probe.wasm",
        "config": {}
      }
    ],
    "sink": {
      "type": "stdout"
    },
    "state": {
      "topic": "count-per-word"
    }
  }
}
