{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {
    "name": "sdf-word-probe-words"
  },
  "spec": {
    "source": {
      "type": "file",
      "path": "examples/sdf/16-word-probe/words.txt"
    },
    "topic": {
      "name": "words-in"
    },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-wordkeys/operator-wordkeys.wasm",
        "config": {}
      }
    ],
    "sink": {
      "type": "topic",
      "name": "word-stream"
    }
  }
}
