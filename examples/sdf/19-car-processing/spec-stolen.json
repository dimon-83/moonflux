{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {
    "name": "stolen"
  },
  "spec": {
    "source": {
      "type": "file",
      "path": "examples/sdf/19-car-processing/cars.jsonl"
    },
    "topic": {
      "name": "cars"
    },
    "state": {
      "topic": "license-plates"
    },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-keyfield/operator-keyfield.wasm",
        "config": {
          "field": "license"
        }
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-stolenplates/operator-stolenplates.wasm",
        "config": {}
      }
    ],
    "sink": {
      "type": "stdout"
    }
  }
}
