{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": { "name": "sdf-word-counter" },
  "spec": {
    "source": { "type": "file", "path": "examples/sdf/15-word-counter/sentences.txt" },
    "topic": { "name": "sentences" },
    "state": { "topic": "word-counts" },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-wordkeys/operator-wordkeys.wasm",
        "config": {}
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-counter/operator-counter.wasm",
        "config": {}
      }
    ],
    "sink": { "type": "stdout" }
  }
}
