{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {
    "name": "sdf-hackernews-notify"
  },
  "spec": {
    "source": {
      "type": "topic",
      "name": "hackernews-stream",
      "from": "beginning"
    },
    "topic": {
      "name": "hackernews-stream"
    },
    "state": {
      "topic": "notify-table"
    },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-wordkeys/operator-wordkeys.wasm",
        "config": {
          "separator": " ",
          "lowercase": true,
          "keep_value": true,
          "field": "title"
        }
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-notify/operator-notify.wasm",
        "config": {
          "title_field": "title",
          "link_field": "link"
        }
      }
    ],
    "sink": {
      "type": "stdout"
    }
  }
}
