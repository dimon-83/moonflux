{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {
    "name": "sdf-bank-overdraft"
  },
  "spec": {
    "source": {
      "type": "topic",
      "name": "business-events-overdraft",
      "from": "beginning"
    },
    "topic": {
      "name": "business-events-overdraft"
    },
    "state": {
      "topic": "account-balance-overdraft"
    },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-bankevents/operator-bankevents.wasm",
        "config": {}
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-balance/operator-balance.wasm",
        "config": {}
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-predicate/operator-predicate.wasm",
        "config": {
          "field": "overdraft",
          "op": "eq",
          "value": true
        }
      }
    ],
    "sink": {
      "type": "stdout"
    }
  }
}
