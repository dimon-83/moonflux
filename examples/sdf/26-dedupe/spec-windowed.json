{
  "apiVersion": "moonflux.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {
    "name": "sdf-dedupe-windowed"
  },
  "spec": {
    "source": {
      "type": "file",
      "path": "examples/sdf/26-dedupe/events.jsonl"
    },
    "topic": {
      "name": "dedupe-events"
    },
    "state": {
      "topic": "dedupe-windowed"
    },
    "transforms": [
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-keyfield/operator-keyfield.wasm",
        "config": {
          "field": "user",
          "lowercase": true
        }
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-tumble/operator-tumble.wasm",
        "config": {
          "time_field": "tst",
          "window_ms": 20000
        }
      },
      {
        "type": "wasm",
        "module": "_build/wasm/debug/build/apps/operator-dedupe/operator-dedupe.wasm",
        "config": {}
      }
    ],
    "sink": {
      "type": "stdout"
    }
  }
}
