// SPDX-License-Identifier: Apache-2.0
// apps/operator-predicate: keep the records whose JSON field satisfies a
// predicate (wasm guest, ABI v1). This is the structural selection tool the
// bank and car examples want: `{"field":"overdraft","eq":true}` or
// `{"field":"mph","gt":60}` — a real predicate, not a substring of a
// canonical JSON rendering (gap 10 in docs/sdf-gap-closure-plan.md).

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonflux/apps/operator-sdk" @sdk,
  "moonflux/core/protocol",
}

pkgtype(kind: "executable")

options(
  link: {
    "wasm": {
      "exports": [
        "mf_op_abi_version",
        "mf_op_alloc_input",
        "mf_op_init",
        "mf_op_process",
        "mf_op_output_len",
        "mf_op_last_status",
        "mf_op_last_error",
      ],
    },
  },
)
