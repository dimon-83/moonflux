// apps/operator-flatmap: a config-driven 1 -> N operator (wasm guest).

import {
  "moonbitlang/core/encoding/utf8",
  "moonflux/apps/operator-sdk" @sdk,
  "moonflux/core/protocol",
}

pkgtype(kind: "executable")

options(
  link: {
    "wasm": {
      "exports": [
        "mf_op_abi_version",
        "mf_op_alloc_input",
        "mf_op_init",
        "mf_op_process",
        "mf_op_output_len",
        "mf_op_last_status",
        "mf_op_last_error",
      ],
    },
  },
)
