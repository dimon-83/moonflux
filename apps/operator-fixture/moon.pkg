// SPDX-License-Identifier: Apache-2.0
// apps/operator-fixture: a config-driven guest whose only purpose is
// to exercise the sandbox's failure paths (trap / refusal / runaway)
// so the P2 gate can prove they surface as structured errors.

import {
  "moonflux/apps/operator-sdk" @sdk,
}

options(
  "is-main": true,
  link: {
    "wasm": {
      "exports": [
        "mf_op_abi_version",
        "mf_op_alloc_input",
        "mf_op_init",
        "mf_op_process",
        "mf_op_output_len",
        "mf_op_last_status",
        "mf_op_last_error",
      ],
    },
  },
)
