// SPDX-License-Identifier: Apache-2.0
// apps/operator-probe: a read-only keyed-state lookup (wasm guest, ABI v1 +
// v3). SDF's word-probe has a second service that reads the first service's
// keyed state; in moonflux that is two pipelines sharing one state TOPIC,
// and this operator is the read half: it looks each record's key up in the
// state it was handed and emits `{"word":...,"count":n}`, writing nothing
// back (P30/T114).

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonflux/apps/operator-sdk" @sdk,
  "moonflux/core/operator",
  "moonflux/core/protocol",
}

pkgtype(kind: "executable")

options(
  link: {
    "wasm": {
      "exports": [
        "mf_op_abi_version",
        "mf_op_alloc_input",
        "mf_op_init",
        "mf_op_process",
        "mf_op_output_len",
        "mf_op_last_status",
        "mf_op_last_error",
        "mf_op_state_abi_version",
        "mf_op_state_apply",
      ],
    },
  },
)
