// apps/client: native transports for the client SDK (TCP, socketpair).
// The protocol and session logic live in core/client.

supported_targets = "native"

import {
  "moonbitlang/core/env",
  "moonflux/core/client" @kernel,
  "moonflux/adapters/net-native" @net,
  "moonflux/adapters/tls-native" @tls,
}
