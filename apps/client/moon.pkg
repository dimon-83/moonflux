// apps/client: moonflux client SDK (protocol v2, native transport).

supported_targets = "native"

import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonflux/core/codec",
  "moonflux/core/log",
  "moonflux/core/protocol",
  "moonflux/core/spec",
  "moonflux/adapters/net-native" @net,
}
