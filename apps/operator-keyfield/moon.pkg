// SPDX-License-Identifier: Apache-2.0
// apps/operator-keyfield: set each record's key from a JSON field, with an
// optional label table (wasm guest, ABI v1). SDF spells this
// `partition.assign-key`; the state layer needs it because state is fetched
// per record key (P30/T114).

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonflux/apps/operator-sdk" @sdk,
  "moonflux/core/protocol",
}

pkgtype(kind: "executable")

options(
  link: {
    "wasm": {
      "exports": [
        "mf_op_abi_version",
        "mf_op_alloc_input",
        "mf_op_init",
        "mf_op_process",
        "mf_op_output_len",
        "mf_op_last_status",
        "mf_op_last_error",
      ],
    },
  },
)
