supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonflux/core/codec",
  "moonflux/core/log",
  "moonflux/core/pipeline",
  "moonflux/core/protocol",
  "moonflux/core/spec",
  "moonflux/apps/client",
  "moonflux/apps/connectors",
  "moonflux/apps/transform",
  "moonflux/adapters/fs-native" @fs,
  "moonflux/adapters/net-native" @net,
}

options(
  "is-main": true,
)
