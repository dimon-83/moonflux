supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonflux/core/codec",
  "moonflux/core/regex",
  "moonflux/core/log",
  "moonflux/core/operator",
  "moonflux/core/auth",
  "moonflux/core/cluster",
  "moonflux/core/group",
  "moonflux/core/pipeline",
  "moonflux/core/replica",
  "moonflux/core/protocol",
  "moonflux/core/spec",
  "moonflux/core/client",
  "moonflux/apps/client" @native,
  "moonflux/apps/connectors",
  "moonflux/apps/transform",
  "moonflux/adapters/fs-native" @fs,
  "moonflux/adapters/net-native" @net,
  "moonflux/adapters/tls-native" @tls,
  "moonflux/adapters/wasmtime-native" @wasmtime,
}

pkgtype(kind: "executable")

options(
  "native-stub": [ "cli_shim.c" ],
)
