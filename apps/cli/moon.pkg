options(
  "is-main": true,
)

supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/core/string" @string,
  "moonflux/core/codec" @codec,
  "moonflux/core/log" @log,
  "moonflux/core/protocol" @protocol,
  "moonflux/adapters/fs-native" @fs,
  "moonflux/adapters/net-native" @net,
}
