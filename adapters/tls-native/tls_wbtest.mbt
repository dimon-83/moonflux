// SPDX-License-Identifier: Apache-2.0
// The adapter's own test: two TLS sessions over one socketpair,
// handshaking by *alternating steps*. No threads — a socketpair is
// bidirectional and both ends are non-blocking, so a loop that pushes
// whichever side is waiting is exactly the cooperative driving the
// servers and clients do.
//
// Certificates come from the environment (`MOONFLUX_TEST_TLS_CERT`,
// `_KEY`, `_CA`), generated by the P12 gate: a test that invented its
// own certificates would need a CA, and a test that ships a private key
// in the repository is a worse idea than one that asks for a path. With
// no paths the test says so and passes, so a machine without `openssl`
// is not blocked by a feature it does not use.

///|
fn test_paths() -> (String, String, String)? {
  let cert = @env.get_env_var("MOONFLUX_TEST_TLS_CERT")
  let key = @env.get_env_var("MOONFLUX_TEST_TLS_KEY")
  let ca = @env.get_env_var("MOONFLUX_TEST_TLS_CA")
  match (cert, key, ca) {
    (Some(cert), Some(key), Some(ca)) => Some((cert, key, ca))
    _ => None
  }
}

///|
test "TLS is available on this machine, or says why not" {
  if !available() {
    println(
      "TLS unavailable here (\{unavailable_reason()}); the negotiated-handshake test is skipped",
    )
  }
  // either way the *check* must not crash: the adapter's contract is that
  // an absent library is a state, not a failure
  assert_true(true)
}

///|
test "a handshake completes when both sides are driven in turn" {
  let paths = match test_paths() {
    Some(paths) => paths
    None => {
      println(
        "no test certificates in the environment; skipping the handshake test",
      )
      return
    }
  }
  let (cert, key, ca) = paths
  let server = match server_context(cert, key, ca, false) {
    Ok(context) => context
    Err(e) => abort("server context: \{e}")
  }
  let client = match client_context(ca, None, None) {
    Ok(context) => context
    Err(e) => abort("client context: \{e}")
  }
  let (a, b) = match @net.socketpair() {
    Ok(pair) => pair
    Err(e) => abort("socketpair: \{e}")
  }
  match a.set_nonblocking(true) {
    Ok(_) => ()
    Err(e) => abort("nonblocking: \{e}")
  }
  match b.set_nonblocking(true) {
    Ok(_) => ()
    Err(e) => abort("nonblocking: \{e}")
  }
  let server_session = match server.attach(a.raw_fd()) {
    Ok(session) => session
    Err(e) => abort("attach server: \{e}")
  }
  let client_session = match client.attach(b.raw_fd()) {
    Ok(session) => session
    Err(e) => abort("attach client: \{e}")
  }
  // alternate steps: each side advances when it has something to do, and
  // both must reach Done within a bounded number of turns
  let mut server_done = false
  let mut client_done = false
  let mut turns = 0
  let mut last_failure = ""
  while (!server_done || !client_done) && turns < 200 && last_failure == "" {
    turns = turns + 1
    if !server_done {
      match server_session.accept() {
        Ok(Done) => server_done = true
        Ok(Pending(_)) => ()
        Err(e) => last_failure = "server: \{e}"
      }
    }
    if !client_done {
      match client_session.connect() {
        Ok(Done) => client_done = true
        Ok(Pending(_)) => ()
        Err(e) => last_failure = "client: \{e}"
      }
    }
  }
  if last_failure != "" {
    abort("handshake failed: \{last_failure}")
  }
  if !server_done || !client_done {
    abort(
      "handshake did not complete in \{turns} turns (server done: \{server_done}, client done: \{client_done})",
    )
  }
  // and the session actually carries bytes both ways
  let payload = b"moonflux"
  let sent = match client_session.write_some(payload) {
    Ok(Some(n)) => n
    Ok(None) => abort("client write wanted more; nothing is in flight")
    Err(e) => abort("client write: \{e}")
  }
  assert_eq(sent, payload.length())
  let buf : FixedArray[Byte] = FixedArray::make(64, b'\x00')
  let mut received : Bytes = b""
  let mut reads = 0
  while received.length() < payload.length() && reads < 50 {
    reads = reads + 1
    match server_session.read_some(buf, buf.length()) {
      Ok(Some(0)) => abort("server saw the connection close mid-read")
      Ok(Some(n)) => received = received + Bytes::from_array(buf[0:n])
      Ok(None) => ()
      Err(e) => abort("server read: \{e}")
    }
  }
  assert_eq(received, payload)
  // `pending` is the reason the poll loop needs it: after one big write
  // the session may hold decrypted bytes while the socket is quiet
  let _ = server_session.pending()
  client_session.close()
  server_session.close()
  client.free()
  server.free()
}
