// SPDX-License-Identifier: Apache-2.0
// adapters/wasmtime-native: operator host via the wasmtime C API
// (dlopen at runtime; no link-time dependency). Requires libwasmtime
// (brew install wasmtime); the shim resolves symbols at runtime and
// honours MOONFLUX_WASMTIME_LIB for non-standard locations.
//
// Imports for tests live in the "wbtest" section.

supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8",
  "moonflux/core/operator",
  "moonflux/core/protocol",
}

import {
  "moonflux/adapters/fs-native" @fs,
} for "wbtest"

options(
  "native-stub": [ "wasmtime_shim.c" ],
  link: {
    "native": { "stub-cc": "clang", "stub-cc-flags": "-I/opt/homebrew/include" },
  },
)
